{
    "name": "larena/link",
    "description": "Larena Link: Shared system package for stable, short, temporary, signed, one-time and action links across Larena without exposing physical resources or bypassing auth/access/audit boundaries.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Rim Zabarov",
            "homepage": "https://github.com/zabarov"
        }
    ],
    "require": {
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Larena\\Link\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larena\\Link\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "test": [
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/InMemoryLinkRuntimeFailsClosedTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/InMemoryLinkRuntimeTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/LinkFailsClosedTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/LinkTargetContractTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkPolicyPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkRuntimePlanningPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkDryRunRuntimePreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicContentLinkFlowPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/LinkSharingSafetyPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/FileManagerLinkSharingRuntimePreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkTokenStorageContractPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkOperatorLifecycleManagementPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkGuardedAdminMutationPlanningPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkRevokeActionPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkRegenerateActionPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkCleanupActionPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkGuardedDeliveryReadinessPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkControlledDeliverySimulationPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkOneTimeConsumptionLifecyclePreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkGuardedRealDeliveryAdapterPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkMutationLadderReviewPreviewTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkDeliveryContractHardeningPreviewTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicLinkRuntimeHardeningPreviewTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/PublicContentLinkFlowRouteBoundaryTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/PublicLinkDryRunRuntimeRouteBoundaryTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/PublicLinkRuntimeHardeningRouteBoundaryTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/PublicLinkGuardedDeliveryReadinessRouteBoundaryTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/PublicLinkControlledDeliverySimulationRouteBoundaryTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/PublicLinkOneTimeConsumptionLifecycleRouteBoundaryTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/PublicLinkTokenStorageContractRouteBoundaryTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/PublicLinkPersistentLookupRouteBoundaryTest.php",
    "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/LinkServiceProviderRegistrationTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Feature/PublicLinkRuntimePlanningRouteBoundaryTest.php"
        ],
        "test:unit": [
            "@test"
        ],
        "lint": "php scripts/lint.php",
        "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=512M",
        "validate:larena": "php scripts/validate-larena-package.php",
        "evidence:check": "php scripts/check-evidence.php",
        "scope:check": "php tools/larena-scope-check.php",
        "quality:gate": [
            "@validate:larena",
            "@lint",
            "@analyse",
            "@test",
            "@larena:metadata:check",
            "@evidence:check",
            "@scope:check"
        ],
        "larena:metadata:check": "php scripts/check-metadata-sync.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larena\\Link\\Providers\\LinkServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.31"
        },
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
